{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Eva Desktop",
  "version": "1.0.0",
  "identifier": "com.openharness.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter web dev",
    "devUrl": "http://localhost:8089",
    "beforeBuildCommand": "pnpm --filter web build",
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Eva Desktop",
        "width": 1180,
        "height": 780,
        "minWidth": 780,
        "minHeight": 560,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/open-harness-sidecar"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
