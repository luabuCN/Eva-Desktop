{
  "name": "eva-desktop",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "concurrently -k -n api,tauri -c cyan,yellow \"node scripts/dev-api.mjs\" \"node scripts/dev-tauri.mjs\"",
    "dev:api": "pnpm --filter server dev",
    "dev:web": "pnpm --filter web dev",
    "build": "pnpm -r build",
    "build:desktop": "node scripts/prepare-sidecar.mjs && pnpm exec tauri build",
    "sidecar:build": "node scripts/prepare-sidecar.mjs",
    "db:push": "pnpm --filter server db:push",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "concurrently": "^9.0.0"
  }
}
