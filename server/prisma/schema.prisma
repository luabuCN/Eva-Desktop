generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Conversation {
  id          String          @id
  title       String          @default("New chat")
  /// 手动重命名后锁定，避免自动标题（最后一条用户消息）再次覆盖。
  titleLocked Boolean         @default(false)
  pinned      Boolean         @default(false)
  archivedAt  DateTime?
  projectId   String?
  project     Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  messages    StoredMessage[]
  runs        ThreadRun[]
  tasks       AgentTask[]
  changes     FileChange[]
}

model StoredMessage {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  kind           String
  sequence       Int
  role           String
  payload        String
  createdAt      DateTime     @default(now())

  @@unique([conversationId, kind, sequence])
  @@index([conversationId, kind, sequence])
}

/// 服务端键值设置（如 wiki.autoIngest 对话自动总结开关）。表由
/// ensureSchema() 运行时创建，这里补齐 Prisma Client 映射。
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Provider {
  id        String   @id @default(uuid())
  name      String   @unique
  type      String
  apiBase   String
  apiKey    String?
  isActive  Boolean  @default(true)
  models    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id                String         @id @default(uuid())
  name              String         @unique
  rootPath          String
  description       String?
  defaultAgentId    String?
  defaultProviderId String?
  defaultModelId    String?
  toolPermissions   String?
  isActive          Boolean        @default(true)
  pinned            Boolean        @default(false)
  archivedAt        DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  conversations     Conversation[]
  runs              ThreadRun[]
  crons             CronJob[]
  mcpServers        McpServer[]
}

/// 用户配置的 MCP 服务器。projectId 为空表示全局级（所有项目可见），
/// 否则为项目级（仅该项目内的运行可用）。args/env/headers 存 JSON 字符串。
model McpServer {
  id          String   @id
  label       String
  description String?
  /// stdio | http
  transport   String
  command     String?
  args        String   @default("[]")
  env         String   @default("{}")
  url         String?
  headers     String   @default("{}")
  enabled     Boolean  @default(true)
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
}

model AgentConfig {
  id                String   @id
  name              String   @unique
  description       String
  instructions      String
  toolPermissions   String
  readOnly          Boolean  @default(false)
  subAgents         String
  defaultProviderId String?
  defaultModelId    String?
  isActive          Boolean  @default(true)
  isBuiltIn         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

/// 委派式子智能体定义（Delegate 工具的后端目录）。内置四条随启动刷新
/// 核心字段；自定义行完全由用户所有。name 是模型调用时的 agent 参数。
model SubAgentDefinition {
  id          String   @id @default(uuid())
  name        String   @unique
  description String
  tools       String
  prompt      String
  providerId  String?
  modelId     String?
  maxTurns    Int?
  isActive    Boolean  @default(true)
  isBuiltIn   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
}

model ThreadRun {
  id             String         @id @default(uuid())
  conversationId String
  conversation   Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  projectId      String?
  project        Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  agentId        String?
  thinkingMode   String         @default("fast")
  permissionMode String         @default("confirm")
  providerId     String?
  modelId        String?
  status         String         @default("queued")
  error          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  startedAt      DateTime?
  completedAt    DateTime?
  events         RunEvent[]
  approvals      ToolApproval[]
  asks           AskUserPrompt[]
  tasks          AgentTask[]
  changes        FileChange[]

  @@index([conversationId, status, createdAt])
  @@index([projectId, createdAt])
}

model RunEvent {
  id        String    @id @default(uuid())
  runId     String
  run       ThreadRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  sequence  Int
  eventType String
  payload   String
  createdAt DateTime  @default(now())

  @@unique([runId, sequence])
  @@index([runId, sequence])
}

model ToolApproval {
  id         String    @id @default(uuid())
  runId      String
  run        ThreadRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  toolName   String
  input      String
  reason     String?
  status     String    @default("pending")
  decisionBy String?
  decidedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([runId, status])
}

/// One interactive question set the askUser tool paused on. The client writes
/// answers back through POST /api/runs/:id/asks/:askId; the tool polls the row
/// (like ToolApproval) so the card survives reloads and background runs.
model AskUserPrompt {
  id        String    @id @default(uuid())
  runId     String
  run       ThreadRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  questions String
  answers   String?
  status    String    @default("pending")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([runId, status])
}

model AgentTask {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  runId          String?
  run            ThreadRun?   @relation(fields: [runId], references: [id], onDelete: SetNull)
  taskId         Int
  subject        String
  description    String?
  status         String       @default("pending")
  activeForm     String?
  owner          String?
  metadata       String?
  blockedBy      String?
  blocks         String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([conversationId, taskId])
  @@index([conversationId, status, taskId])
  @@index([runId])
}

/// Registry-backed catalog row for every tool a provider can contribute.
/// id is the tool name (e.g. "readFile", future "mcp:{server}_{tool}").
/// Metadata is refreshed from ToolProviderRegistry on startup; isActive and
/// config are user-owned and never overwritten by the sync.
model ToolRecord {
  id          String   @id
  label       String
  description String
  risk        String   @default("medium")
  mutating    Boolean  @default(false)
  providerId  String   @default("builtin")
  isActive    Boolean  @default(true)
  config      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([providerId])
}

/// 技能（SKILL.md 指令文档）的启用状态。key 形如 "<source>:<id>"；
/// 名称/描述/路径等元数据始终来自磁盘实时扫描，这里只存用户偏好。
model SkillRecord {
  key       String   @id
  source    String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([source])
}

/// One workspace file edit performed by an edit tool (writeFile/editFile).
/// Rows power the changes panel (per-path latest wins) and one-click revert
/// via the stored before snapshot. Run deletion keeps rows for the panel;
/// conversation deletion removes them.
model FileChange {
  id             String       @id @default(uuid())
  runId          String?
  run            ThreadRun?   @relation(fields: [runId], references: [id], onDelete: SetNull)
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  projectId      String?
  path           String
  changeKind     String
  before         String?
  after          String?
  unifiedDiff    String?
  additions      Int          @default(0)
  deletions      Int          @default(0)
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([projectId, createdAt])
  @@index([runId])
}

/// 知识库页面（llm-wiki 架构：LLM 增量维护的持久 wiki）。scopeId 为
/// "default"（默认工作区知识库）或 "p:<projectId>"（项目专属知识库）。
/// path 形如 "entities/react.md"；content 是 markdown 正文；meta 存
/// frontmatter JSON（tags / sources / related / summary）。
model WikiPage {
  id        String   @id @default(uuid())
  scopeId   String
  path      String
  title     String
  /// overview | index | log | entity | concept | source | query
  type      String
  content   String
  meta      String   @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([scopeId, path])
  @@index([scopeId, type])
}

/// 知识库原文档（llm-wiki 的 raw/sources 层）：上传文档提取的原始全文，
/// 不可变；sources/ 来源页正文从这里渲染，导出 Obsidian 时也写原文。
/// 同名重复上传按 (scopeId, filename) 覆盖更新。
model WikiDocument {
  id        String   @id @default(uuid())
  scopeId   String
  filename  String
  title     String
  text      String
  chars     Int      @default(0)
  truncated Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([scopeId, filename])
  @@index([scopeId])
}

/// 知识库总结任务：对话回合完成后自动入队（或手动触发），串行消费。
/// fromSeq/toSeq 圈定要总结的 StoredMessage（ui 快照）sequence 区间。
/// 同一会话的 queued 任务会合并（窗口取并集），避免连续回合逐条调用 LLM。
/// sourceKind=document 的任务是手动上传文档：payload 存提取文本
/// （{filename, title, text}），conversationId 为空串。
model WikiIngestJob {
  id             String    @id @default(uuid())
  scopeId        String
  conversationId String    @default("")
  projectId      String?
  fromSeq        Int       @default(0)
  toSeq          Int       @default(0)
  /// conversation | document
  sourceKind     String    @default("conversation")
  payload        String    @default("{}")
  /// auto = 回合完成自动入队；manual = 会话内手动保存；rebuild = 从历史会话构建；upload = 手动上传文档
  trigger        String    @default("auto")
  status         String    @default("queued")
  error          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  completedAt    DateTime?

  @@index([scopeId, status, createdAt])
  @@index([conversationId])
}

/// 自动化定时任务：到点（croner 按本机时区调度）以机器人身份发起一次
/// 完整的 agent 运行，产物是普通会话；runHistory 为内嵌 JSON（最近 50 条）。
model CronJob {
  id                    String    @id @default(uuid())
  name                  String    @unique
  prompt                String
  cron                  String
  description           String?
  projectId             String?
  project               Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  agentId               String?
  permissionMode        String    @default("confirm")
  isActive              Boolean   @default(true)
  reuseThread           Boolean   @default(false)
  lastRunAt             DateTime?
  lastRunEndAt          DateTime?
  lastRunStatus         String?
  lastRunError          String?
  lastRunConversationId String?
  runHistory            String    @default("[]")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([isActive])
}
