{
  "name": "@openharness-desktop/server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "db:push": "node -e \"require('fs').closeSync(require('fs').openSync('.local-data/openharness.db','a'))\" && prisma db push"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^3.0.32",
    "@ai-sdk/openai": "^3.0.30",
    "@ai-sdk/openai-compatible": "^2.0.72",
    "@hono/node-server": "^1.6.0",
    "@mastra/ai-sdk": "1.9.1",
    "@mastra/core": "1.61.0",
    "@prisma/client": "^6.5.0",
    "ai": "^6.0.97",
    "croner": "^9.0.0",
    "diff": "^9.0.0",
    "dotenv": "^16.4.5",
    "hono": "^4.5.0",
    "jszip": "^3.10.1",
    "pdf-parse": "^2.4.5",
    "simple-git": "^3.36.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.0",
    "postject": "^1.0.0-alpha.6",
    "prisma": "^6.5.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0"
  }
}
